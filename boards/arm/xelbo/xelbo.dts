/dts-v1/;

#include <nordic/nrf52833_qiaa.dtsi>
#include <common/nordic/nrf52833_uf2_boot_mode.dtsi>
#include <dt-bindings/led/led.h>

/ {
	model = "Xelbo";

	chosen {
		zephyr,code-partition = &code_partition;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
        zmk,battery = &vbatt;
	};

    vbatt: vbatt {
        compatible = "zmk,non-lipo-battery";
        io-channels = <&adc 6>; 
    };

	xiao_d: connector {
		compatible = "seeed,xiao-gpio";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map
			= <0 0 &gpio0 5 0>		/* D0 */
			, <1 0 &gpio0 4 0>		/* D1 */
			, <2 0 &gpio0 29 0>		/* D2 */
			, <3 0 &gpio0 3 0>		/* D3 */
			, <4 0 &gpio0 26 0>		/* D4 */
			, <5 0 &gpio0 27 0>		/* D5 */
			, <6 0 &gpio1 8 0>		/* D6 */
			, <7 0 &gpio0 14 0>		/* D7 */
			, <8 0 &gpio0 17 0>		/* D8 */
			, <9 0 &gpio0 15 0>		/* D9 */
			, <10 0 &gpio0 7 0>		/* D10 */
			;
	};

    ws2812_gpio: ws2812_gpio {
        compatible = "zmk,ws2812-gpio";
        gpio-controller;
        #gpio-cells = <2>;
		led-strip = <&xelbo_led>;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&ws2812_gpio 0 GPIO_ACTIVE_HIGH>;
			label = "Red channel";
		};
		led1: led_1 {
			gpios = <&ws2812_gpio 1 GPIO_ACTIVE_HIGH>;
			label = "Green channel";
		};
		led2: led_2 {
			gpios = <&ws2812_gpio 2 GPIO_ACTIVE_HIGH>;
			label = "Blue channel";
		};
	};

	EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
        init-delay-ms = <50>;
    };

    magic_mapper {
        compatible = "zmk,bootmode-to-magic-mapper";
        status = "okay";

        #address-cells = <1>;
        #size-cells = <1>;

        boot_retention: retention@0 {
            compatible = "zephyr,retention";
            status = "okay";
            reg = <0x0 0x1>;
        };
    };

	aliases {
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
	};
};


&adc {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&pinctrl {
	spi2_default: spi2_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 8)>, // Dummy clock to avoid the SPI bus from being powered down
			<NRF_PSEL(SPIM_MOSI, 0, 6)>;
		};
	};

	spi2_sleep: spi2_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 8)>, // Dummy clock to avoid the SPI bus from being powered down
			<NRF_PSEL(SPIM_MOSI, 0, 6)>;
			low-power-enable;
		};
	};
};

&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	xelbo_led: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <4000000>;
		chain-length = <1>;
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
	};
};

xiao_serial: &uart0 {
};

zephyr_udc0: &usbd {
    status = "okay";
};

&reg1 {
    regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&gpregret1 {
    adafruit_boot_retention: retention@0 {
        compatible = "zephyr,retention";
        status = "okay";
        reg = <0x0 0x1>;
    };
};

&flash0 {
	/*
	 * For more information, see:
	 * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
	 */
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		code_partition: partition@1000 {
			label = "code_partition";
			reg = <0x00001000 0x0006b000>;
		};

		/*
		 * Storage partition will be used by FCB/LittleFS/NVS
		 * if enabled.
		 */
		storage_partition: partition@6c000 {
			label = "storage";
			reg = <0x0006c000 0x00008000>;
		};

		boot_partition: partition@74000 {
			label = "xelbo_boot";
			reg = <0x00074000 0x0000C000>;
		};
	};
};
